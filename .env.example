TELEGRAM_BOT_TOKEN=your_telegram_bot_token
COINPAYMENTS_MERCHANT_ID=your_coinpayments_merchant_id
COINPAYMENTS_PUBLIC_KEY=your_coinpayments_public_key
COINPAYMENTS_PRIVATE_KEY=your_coinpayments_private_key

# webhook/public URL for IPN/health (must be accessible from CoinPayments)
PUBLIC_URL=https://your-sevalla-domain.example

# Admin usernames (comma-separated) - username as shown in Telegram (without @)
ADMINS=nasharuddin,otheradmin

# Referral payout threshold (USDT)
REFERRAL_PAYOUT_THRESHOLD=50

# Referral reward per sign-up (USDT)
REFERRAL_REWARD=1.5

# Min & max sell limits
MIN_USDT=25
MAX_USDT=50000

# Start rates (will auto-update)
RATE_USD=1.05
RATE_EUR=0.89
RATE_GBP=0.79

# Port for server
PORT=3000
